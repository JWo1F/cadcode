{
  "name": "cadcode",
  "version": "0.7.0",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "types": "tsc -p tsconfig.json",
    "prepack": "npm run types",
    "site": "node site/build.js"
  },
  "keywords": [
    "cad",
    "csg",
    "3d-printing",
    "stl",
    "3mf",
    "manifold"
  ],
  "license": "MIT",
  "description": "Code-first CAD: write models in JavaScript, preview live in the browser, export STL, 3MF and PNG.",
  "dependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0",
    "svgpath": "^2.6.0",
    "three": "^0.187.0",
    "ws": "^8.22.1"
  },
  "type": "module",
  "bin": {
    "cadcode": "src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/lib/index.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "client",
    "types"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "monaco-editor": "0.57.0",
    "typescript": "6.0.3"
  },
  "homepage": "https://jwo1f.github.io/cadcode/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JWo1F/cadcode.git"
  },
  "bugs": {
    "url": "https://github.com/JWo1F/cadcode/issues"
  }
}
